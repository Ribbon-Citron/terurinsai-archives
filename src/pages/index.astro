
---
import BaseLayout from "../layouts/BaseLayout.astro";
import { festivals } from "../data/festivals";
---

<BaseLayout>

  <section class="container section">
    <div class="section-title">ポスター,出演者,写真など お祭りの豊かな歴史を物語る数々の資料</div>
    <div class="festival-grid">
      {festivals.map((festival) => (
        <a
          href={`/archive/${festival.id}/`}
          class="festival-card"
        >
          <div class="poster">
            <img
              src={festival.poster}
              alt={festival.title}
            />
          </div>
          <h3>{festival.titleTop}【{festival.year}】</h3>
        </a>
      ))}
    </div>
  </section>

</BaseLayout>

<style>
  /* .hero {
    background: #f0eeee;
    padding: 90px 0;
    text-align: center;
  } */

  /* .eyebrow {
    font-size: 12px;
    letter-spacing: 0.2em;
    color: #888;
  } */

  /* h2 {
    font-weight: 800;
    text-align: center;
  } */

  .section-title {
    /* font-weight: 800; */
    text-align: center;
    font-size: 0.8rem;
    color: #555;
  }
/* 
  .about-link {
    display: inline-block;
    margin-top: 20px;
    color: #555;
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 4px;
  } */

  .festival-grid {
    display: grid;
    grid-template-columns: repeat(5, 160px);
    justify-content: center;
    gap: 20px 10px;
  }

  .festival-card {
    width: 160px;
    min-width: 0;
  }

  .poster {
    width: 160px;
    height: 226px;
    /* background: #000000; */
    overflow: hidden;
    border-radius: 8px;
    /* border: 0px solid #64605f; */
  }

  .poster img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .festival-card h3 {
    font-size: 0.8rem;
    font-weight: 600;
    margin: 0;
    text-align: center;
  }

  .festival-card:hover img {
    opacity: 0.85;
  }

  @media (max-width: 600px) {
    .festival-grid {
      grid-template-columns: repeat(2, 160px);
      justify-content: center;
      gap: 20px 10px;
    }

    .festival-card {
      width: 160px;
    }

    .festival-card h3 {
      font-size: 0.7rem;
    }

    /* .hero {
      padding: 64px 0;
    } */
  }
 
  @media (max-width: 900px) {
    .festival-grid {
      grid-template-columns: repeat(4, 160px);
      justify-content: center;
      gap: 20px 10px;
    }

    .festival-card {
      width: 160px;
    }

    .festival-card h3 {
      font-size: 0.7rem;
    }

    /* .hero {
      padding: 64px 0;
    } */
  }
</style>