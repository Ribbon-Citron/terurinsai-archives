---
import BaseLayout from "../layouts/BaseLayout.astro";
import { festivals } from "../data/festivals";
---

<BaseLayout>
  <section class="container section">
    <div class="section-title">Archives Data</div>
    <div class="festival-grid">
      {festivals.map((festival) => (
        <a href={`/archive/${festival.id}/`} class="festival-card">
          <div class="poster">
            <img src={festival.poster} alt={festival.title} />
          </div>
          <h3>
            {festival.titleTop}【{festival.year}】
          </h3>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .section-title {
    text-align: center;
    font-size: 0.8rem;
    color: #555;
  }

  .festival-grid {
    display: grid;
    grid-template-columns: repeat(5, 160px);
    justify-content: center;
    gap: 20px 10px;
  }

  .festival-card {
    width: 160px;
    min-width: 0;
  }

  .poster {
    width: 160px;
    height: 226px;
    /* background: #000000; */
    overflow: hidden;
    border-radius: 8px;
    /* border: 0px solid #64605f; */
  }

  .poster img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .festival-card h3 {
    font-size: 0.8rem;
    font-weight: 600;
    margin: 0;
    text-align: center;
  }

  .festival-card:hover img {
    opacity: 0.85;
  }

  @media (max-width: 600px) {
    .section-title {
      text-align: center;
      font-size: 1rem;
      color: #555;
    }
    .festival-grid {
      grid-template-columns: repeat(2, 160px);
      justify-content: center;
      gap: 20px 10px;
    }

    .festival-card {
      width: 160px;
    }

    .festival-card h3 {
      font-size: 0.9rem;
    }
  }

  @media (min-width: 601px) and (max-width: 900px) {
    .section-title {
      text-align: center;
      font-size: 0.9rem;
      color: #555;
    }
    .festival-grid {
      grid-template-columns: repeat(4, 160px);
      justify-content: center;
      gap: 20px 10px;
    }

    .festival-card {
      width: 160px;
    }

    .festival-card h3 {
      font-size: 0.8rem;
    }
  }
</style>
