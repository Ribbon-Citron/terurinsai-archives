---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { festivals } from "../../data/festivals";
import type { Festival } from "../../data/festivals";

export function getStaticPaths() {
  return festivals.map((festival) => ({
    params: { id: String(festival.id) },
    props: { festival },
  }));
}

const { festival } = Astro.props as { festival: Festival };
const hasRecords =
  festival.visitors ||
  festival.weather ||
  festival.cashflow ||
  festival.donation ||
  festival.description1 ||
  festival.description2;
---

<BaseLayout title={`${festival.title}｜コザ･てるりん祭`}>
  <section class="container section">
    <div class="festival-detail">
      <div class="main-poster">
        <img src={festival.poster} alt={festival.title} />
      </div>

      <div class="information">
        <h1>{festival.title}</h1>

        {festival.date && (
          <p>
            {festival.year} {festival.date} {festival.time}
          </p>
        )}
        <br />

        {festival.performers.length > 0 && (
          <p>
            ■出演(読み仮名50音順)
            <br />
            {festival.performers.join(", ")}
          </p>
        )}
        <br />

        {festival.venue && (
          <p>
            ■会場
            <br />
            {festival.venue}
          </p>
        )}
        <br />

        {(festival.description1 || festival.description2) && (
          <p>
            ■運営
            {festival.description1 && (
              <>
                <br />
                {festival.description1}
              </>
            )}
            {festival.description2 && (
              <>
                <br />
                {festival.description2}
              </>
            )}
          </p>
        )}
        <br />
      </div>
    </div>

    {hasRecords && (
      <section class="records">
        <h2>開催記録</h2>
        <div class="record-list">
          {festival.visitors && <p>来場者数：{festival.visitors}</p>}
          {festival.weather && <p>天気：{festival.weather}</p>}
          {festival.cashflow && <p>収支：{festival.cashflow}</p>}
          {festival.donation && <p>寄付：{festival.donation}</p>}
        </div>
      </section>
    )}

    {festival.additionalImages.length > 0 && (
      <section class="additional">
        <h2>関連イベント</h2>
        <div class="additional-layout">
          <div class="additional-grid">
            {festival.additionalImages.map((photo) => (
              <img
                src={photo}
                alt={`${festival.title}の追加写真`}
                loading="lazy"
              />
            ))}
          </div>
          {festival.additionalText && (
            <div class="additional-text">{festival.additionalText}</div>
          )}
        </div>
      </section>
    )}

    {festival.gallery.length > 0 && (
      <section class="gallery">
        <h2>写真</h2>

        <p class="photo-archive">
          <a href={`/archive/${festival.id}/gallery/`}>写真一覧を見る →</a>
        </p>

        <div class="gallery-grid">
          {festival.gallery.map((photo) => (
            <img src={photo} alt={`${festival.title}の写真`} loading="lazy" />
          ))}
        </div>
      </section>
    )}
  </section>
</BaseLayout>

<style>
  .festival-detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }

  .main-poster {
    min-width: 0;
    background: #222;
    text-align: center;
  }

  .main-poster img {
    display: block;
    width: 100%;
    max-width: 452px;
    height: auto;
    margin: 0 auto;
    border-radius: 16px;
  }

  .information {
    min-width: 0;
    color: #fff;
  }

  .information h1 {
    margin: 0 0 20px 0;
    font-size: 1.2rem;
    line-height: 1.5;
  }

  .information p,
  .record-list p,
  .additional-text {
    font-size: 0.9rem;
    margin: 0 0 1px 0;
    line-height: 1.5;
  }

  .records,
  .additional,
  .gallery {
    width: 95%;
    margin: 64px auto;
  }

  .records h2,
  .additional h2,
  .gallery h2 {
    font-size: 1rem;
    border-bottom: 2px solid #ddd;
    padding-bottom: 2px;
    margin-bottom: 10px;
  }

  .additional h2 {
    font-size: 1rem;
    border-bottom: 2px solid #ddd;
    padding-bottom: 2px;
    margin-bottom: 20px;
  }

  .additional-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .additional-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0fr, 1fr);
    gap: 20px;
    align-items: start;
  }

  .additional-grid img {
    display: block;
    max-width: 260px;
    height: auto;
    margin: 0 auto;
    border-radius: 8px;
  }

  .gallery-grid {
    gap: 16px;
  }

  .gallery-grid img {
    /* width: 100%; */
    /* max-width: 452px; */
    max-height: 300px;
    margin: 0 auto;
    border-radius: 8px;
  }

  .photo-archive {
    margin: 20px 0 20px;
    text-align: center;
  }

  .photo-archive a {
    display: inline-block;
    padding: 6px 16px;
    border: 1px solid #bbb;
    border-radius: 4px;
    color: #bbb;
    font-size: 0.8rem;
    text-decoration: none;
    transition: background 0.2s;
  }

  .photo-archive a:hover {
    background: #222222;
  }

  @media (max-width: 900px) {
    .additional-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .additional-grid img {
      display: block;
      max-width: 300px;
      height: auto;
      margin: 0 auto;
      border-radius: 8px;
    }

    @media (max-width: 600px) {
      .festival-detail,
      .additional-layout {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .additional-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .additional-grid img {
        max-width: 300px;
      }
      .main-poster img {
        max-height: none;
      }

      .information h1 {
        font-size: 21px;
        margin-bottom: 14px;
      }

      .information p {
        font-size: 13px;
        margin-bottom: 10px;
      }

      .records,
      .gallery {
        margin-top: 40px;
      }

      .gallery-grid {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
