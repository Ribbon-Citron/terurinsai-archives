
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { festivals } from "../../data/festivals";

export function getStaticPaths() {
  return festivals.map((festival) => ({
    params: { id: String(festival.id) },
    props: { festival },
  }));
}

const { festival } = Astro.props;

const hasRecords =
  festival.visitors || festival.income || festival.expenses;
---

<BaseLayout title={`${festival.title}｜コザ・てるりん祭`}>
  <section class="container section">
    <a href="/" class="back-link">← アーカイブ一覧へ戻る</a>

    <div class="festival-detail">
      <div class="main-poster">
        <img src={festival.poster} alt={festival.title} />
      </div>

      <div class="information">
        <h1>{festival.title}</h1>

        {festival.date && (
          <p>{festival.date} {festival.time}</p>
        )}

        {festival.performers.length > 0 && (
          <p>出演者：{festival.performers.join("、")}</p>
        )}

        {festival.venue && (
          <p>会場：{festival.venue}</p>
        )}

        {festival.description && (
          <p>{festival.description}</p>
        )}
      </div>
    </div>

    {hasRecords && (
      <section class="records">
        <h2>開催記録</h2>
        <div class="record-list">
          {festival.visitors && (
            <p>来場者数：{festival.visitors}</p>
          )}
          {festival.income && (
            <p>収入：{festival.income}</p>
          )}
          {festival.expenses && (
            <p>支出：{festival.expenses}</p>
          )}
        </div>
      </section>
    )}


    {festival.additionalImages.length > 0 && (
      <section class="additional">
        <div class="additional-layout">
          <div class="additional-grid">
            {festival.additionalImages.map((photo) => (
              <img
                src={photo}
                alt={`${festival.title}の追加写真`}
                loading="lazy"
              />
            ))}
          </div>

          {festival.additionalText && (
            <div class="additional-text">
              {festival.additionalText}
            </div>
          )}
        </div>
      </section>
    )}

    {festival.gallery.length > 0 && (
      <section class="gallery">
        <h2>写真ギャラリー</h2>
        <div class="gallery-grid">
          {festival.gallery.map((photo) => (
            <img
              src={photo}
              alt={`${festival.title}の写真`}
              loading="lazy"
            />
          ))}

        </div>
      </section>
    )}

</section>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 28px;
    font-size: 13px;
    color: #777;
  }

  .festival-detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }

  .main-poster {
    background: #f0f0f0;
    text-align: center;
    min-width: 0;
  }

  .main-poster img {
    width: 100%;
    max-height: 650px;
    object-fit: contain;
  }

  .information {
    min-width: 0;
  }

  .information h1 {
    margin: 0 0 24px;
    font-size: 26px;
    line-height: 1.5;
  }

  .information p {
    font-size: 14px;
    margin: 0 0 18px;
    line-height: 2;
  }

  .records,
  .gallery {
    margin-top: 64px;
  }

  .records h2,
  .gallery h2 {
    font-size: 21px;
    border-bottom: 1px solid #ddd;
    padding-bottom: 12px;
    margin-bottom: 24px;
  }

  .record-list p {
    font-size: 13px;
    margin: 8px 0;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .gallery-grid img {
    width: 100%;
    height: auto;
  }

    .additional {
      margin-top: 48px;
    }

    .additional-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .additional-grid img {
      width: 100%;
      height: auto;
    }


  .additional {
    margin-top: 48px;
  }

  .additional-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }

  .additional-grid {
    display: grid;
    gap: 16px;
  }

  .additional-grid img {
    display: block;
    width: 100%;
    height: auto;
  }

  .additional-text {
    line-height: 1.9;
    white-space: pre-line;
  }

  @media (max-width: 600px) {
    .additional-layout {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .additional-grid {
    grid-template-columns: 1fr;
    }

    .festival-detail {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .main-poster img {
      max-height: none;
    }

    .information h1 {
      font-size: 21px;
      margin-bottom: 14px;
    }

    .information p {
      font-size: 13px;
      margin-bottom: 10px;
    }

    .records,
    .gallery {
      margin-top: 40px;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
