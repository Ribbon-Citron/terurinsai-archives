<link rel="preconnect" href="https://googleapis.com" />
<link rel="preconnect" href="https://gstatic.com" crossorigin />
<link
  href="https://googleapis.com/css2?family=Yuji+Boku&display=swap"
  rel="stylesheet"
/>

<header class="header">
  <div class="container header-inner">
    <!-- 左側：ロゴ画像 ＋ タイトル -->
    <a href="/" class="logo-area">
      <img src="/newlogo.png" alt="Logo" class="logo-img" />
      <span class="logo-main">コザ･てるりん祭 Archives</span>
    </a>

    <!-- 右側：ナビゲーションリンク -->
    <nav class="header-nav">
      <a href="/" class="nav-link">
        TOP
      </a>
      <a href="#footer" class="nav-link">
        ASK
      </a>
      <a href="/about" class="nav-link">
        ABOUT
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    background: #ece9e9;
    border-top: 10px solid #444444;
    border-bottom: 5px solid #555555;
    margin-bottom: 1px;
    padding: 0;
  }

  .header-inner {
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0px auto;
    padding: 12px 8px;
  }

  .logo-area {
    display: flex; /* 👈 これで横並びに */
    align-items: center; /* 👈 上下の中央を揃える */
    gap: 0px; /* 👈 ロゴと文字の間隔 */
    text-decoration: none; /* 下線を消す */
    color: inherit; /* 文字色を継承 */
  }

  .logo-img {
    width: 64px;
    height: 64px;
    object-fit: contain;
  }

  .logo {
    display: flex;
    flex-direction: column;
    line-height: 1.6;
  }

  .logo-main {
    font-family: "Yuji Boku", serif;
    font-size: 1.4rem; /* 大きめに設定 */
    letter-spacing: 0.05em; /* 文字の間隔を少し広げて堂々と見せる */
    text-shadow: 1px 1px 3px #5e2d06; /* 祭りの赤（朱色）で影をつけて立体感を出す */
    margin: 0;
    color: #030101;
  }

  /* 右側のリンクを横並びにする */
  .header-nav {
    display: flex;
    gap: 16px;
    align-self: flex-end; /* 👈 これで親の下端にピタッとくっつく */
    margin-bottom: 1px; /* 下からの微調整用（必要に応じて） */
  }

  /* 各リンクのデザイン */
  .nav-link {
    text-decoration: none;
    color: #334155;
    font-size: 0.8rem;
    font-family: "Yuji Boku", serif;
    text-shadow: 1px 1px 3px #48448a;
    margin: 0;
  }

  @media (max-width: 600px) {
    .header-inner {
      flex-direction: column; /* スマホでは縦並び */
      align-items: flex-start; /* 👈 全体を左側に寄せる場合 */
      justify-content: center;
      gap: 0px;
      font-family: "Yuji Boku", serif;
      padding: 10px 0px 0px 0px; /* 👈 左右に少し隙間（12px）を開ける */
    }

    /* 1段目のロゴとテキストのエリアを確実に左寄せにする */
    .logo-area {
      align-self: flex-start; /* 👈 これで左端に寄る */
    }

    .logo-main {
      font-size: 1.2rem;
    }

    .nav-link {
      font-size: 0.7rem;
    }
  }
</style>
