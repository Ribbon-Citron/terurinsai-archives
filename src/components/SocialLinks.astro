---
import { siteInfo } from "../data/site";

const links = [
  {
    name: "Facebook",
    url: siteInfo.facebookUrl,
    icon: `<path fill="currentColor" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>`,
  },
  {
    name: "X",
    url: siteInfo.xUrl,
    icon: `<path fill="currentColor" d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/>`,
  },
].filter((link) => link.url);
---

<div class="social-area">
  <p class="social-heading">Follow us on the web</p>

  <div class="social-links">
    {links.map((link) => (
      <a
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class={`social-icon ${link.name.toLowerCase()}`}
        title={link.name}
        aria-label={link.name}
      >
        <svg viewBox="0 0 24 24" class="icon" set:html={link.icon} />
      </a>
    ))}
  </div>
</div>

<style>
  .social-area {
    text-align: center;
    margin: 10px 0;
  }

  .social-heading {
    margin: 0;
    font-size: 0.8rem;
    color: #f5efef;
    /* letter-spacing: 0.08em; */
  }

  .social-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin: 1% 0;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #999;
    text-decoration: none;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .social-icon .icon {
    width: 24px;
    height: 24px;
  }

  .social-icon:hover {
    transform: translateY(-2px);
  }

  .social-icon.facebook:hover {
    color: #1877f2;
  }

  .social-icon.x:hover {
    color: #000;
  }

  @media (max-width: 600px) {
    .social-links {
      gap: 14px;
    }
  }
</style>
