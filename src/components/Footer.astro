---
import SocialLinks from "./SocialLinks.astro";
import { siteInfo } from "../data/site";
---

<footer id="footer" class="footer">
  <div class="container">
    <SocialLinks />

    <h2>お問い合わせ</h2>
    <p>{siteInfo.organizer}</p>
    <p>
      {siteInfo.phone1}：{siteInfo.address1}
    </p>
    <p>
      {siteInfo.phone2}：{siteInfo.address2}
    </p>

    <div class="copyright">© てるりん祭実行委員会 2009</div>
  </div>
</footer>

<style>
  .footer {
    background: #555555;
    border-top: 0px solid #791313;
    padding: 0;
    color: #f0e6e6;
    font-size: 0.8rem;
    margin-top: 20px;
  }

  .container {
    margin: 0 0 0 1rem;
  }

  .container h2 {
    font-size: 1rem;
    margin-bottom: 1px;
  }

  .container p {
    margin: 0 0 0 4px;
  }

  .copyright {
    color: #ccc;
    padding: 8px 0 10px;
    border-top: 1px solid #888;
    margin-top: 20px;
    font-size: 0.8rem;
    text-align: center;
  }
</style>
