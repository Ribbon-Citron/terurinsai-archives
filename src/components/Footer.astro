
---
import SocialLinks from "./SocialLinks.astro";
import { siteInfo } from "../data/site";
---

<footer class="footer">
  <div class="container">

    <SocialLinks />

    <div class="contact">
      <h2>お問い合わせ</h2>
      <p>主催：{siteInfo.organizer}</p>
      <p>住所：{siteInfo.address}</p>
      <p>電話：{siteInfo.phone}</p>
    </div>

    <div class="copyright">
      ©  Copyright てるりん祭実行委員会 2011. All Rights Reserved.
    </div>

  </div>
</footer>

<style>
  .footer {
    background: #3b3b3b;
    border-top: 10 solid #550606;
    padding: 0;
    color: #f0e6e6;
    font-size: 0.8rem;
  }

  .contact {
    margin-bottom: 20px;
  }

  .contact h2 {
    font-size: 0.85rem;
    margin-bottom: 1px;
  }

  .contact p {
    margin: 0;
  }

  .copyright {
    padding-top: 10px;
    border-top: 1px solid #ddd;
    font-size: 0.8rem;
    text-align: center;
  }
</style>
