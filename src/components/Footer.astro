---
import SocialLinks from "./SocialLinks.astro";
import { siteInfo } from "../data/site";
---

<footer id="footer" class="footer">
  <div class="container">
    <SocialLinks />

    <h2>お問い合わせ</h2>
    <p>{siteInfo.organizer}</p>
    <p>
      {siteInfo.phone1}：{siteInfo.address1}
    </p>
    <p>
      {siteInfo.phone2}：{siteInfo.address2}
    </p>

    <div class="copyright">© てるりん祭実行委員会 2009</div>
  </div>
</footer>

<style>
  .footer {
    background: #555555;
    border-top: 3px solid #791313;
    padding: 0;
    color: #f0e6e6;
    font-size: 0.8rem;
    margin-top: 20px;
  }

.container {
    width: 100%;
    margin: 0px auto;
    padding: 0px 0px 4px 0px;
  }

  .container h2 {
    font-size: 1rem;
    margin-bottom: 2px;
    margin: 0 0 0 5rem;
  }

  .container p {
    font-size: 0.8rem;
    margin-bottom: 0px;
    margin: 0 0 0 6rem;
  }

  .copyright {
    width: 100%; 
    color: #ccc;
    padding: 4px 0 10px 0;
    border-top: 1px solid #888;
    margin-top: 4px;
    font-size: 0.8rem;
    text-align: center;
  }
</style>
